# ───────────── CareerPilot AI – server configuration ─────────────
# Copy to server/.env and fill in. NEVER commit real secrets. All keys stay server-side.

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend (used in email links)
APP_URL=http://localhost:5173

# Session signing secret – REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Cross-site cookies (frontend and API on different domains without a rewrite proxy): COOKIE_SAMESITE=none + COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Optional: only these emails may toggle job sources / trigger global collection (empty = any signed-in user)
ADMIN_EMAILS=

# ───────────── Database ─────────────
# Supabase / PostgreSQL connection string. Leave empty to use the embedded PGlite database (local dev only).
# Supabase: Project Settings → Database → Connection string (URI). Use the pooler URI with DATABASE_SSL=true.
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DIR=.data/pglite

# ───────────── Authentication ─────────────
# local    = email/password with bcrypt, stored in your database
# supabase = Supabase Auth (sign-up / sign-in delegated to Supabase; app session cookie issued by this server)
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ───────────── AI (OpenAI) ─────────────
# Without a key the app uses its built-in offline evaluator and rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ───────────── Email digest ─────────────
# EMAIL_TRANSPORT: smtp | json (test transport – records but does not deliver) | empty (disabled)
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CareerPilot AI <alerts@yourdomain.com>"

# ───────────── Telegram (optional) ─────────────
# Create a bot with @BotFather and paste its token. Each user adds their chat ID in Daily Job Alerts.
TELEGRAM_BOT_TOKEN=

# ───────────── Scheduler ─────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
# Daily job collection (cron syntax, in SCHEDULER_TIMEZONE)
JOB_COLLECTION_CRON=0 6 * * *
# How often to check whether any user's digest is due
DIGEST_CHECK_CRON=*/15 * * * *

# ───────────── Job sources (authorised APIs only) ─────────────
ENABLE_LIVE_SOURCES=true
# Greenhouse public Job Board API board tokens (company career pages), comma separated
GREENHOUSE_BOARDS=razorpaysoftwareprivatelimited,groww
# Lever public Postings API company slugs, comma separated
LEVER_COMPANIES=
# Adzuna Jobs API (India) – free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch on RapidAPI (LinkedIn / Indeed / Naukri listings via Google for Jobs) – https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Clearly-labelled demo listings shown only when no live data exists
SEED_DEMO_JOBS=true

# Vercel Cron authorisation for /api/cron/daily (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
# Serverless previews only: throw-away database in /tmp (data is LOST between cold starts)
ALLOW_EPHEMERAL_DB=false

MAX_UPLOAD_MB=5
# Serve client/dist from this server (single-service deployment)
SERVE_CLIENT=false
